# better-auth declares better-sqlite3 ^12 as an OPTIONAL peer. "Optional" only means it need not be
# installed -- npm still enforces the version range when it is, and this repo runs ^13.0.3, so a
# clean `npm ci` fails with ERESOLVE without this. Not a real incompatibility: better-auth's kysely
# adapter duck-types the connection ("open"/"close"/"prepare" in db) and never imports the package.
# This lives in a committed .npmrc rather than a README note so the Docker build installs identically.
legacy-peer-deps=true
